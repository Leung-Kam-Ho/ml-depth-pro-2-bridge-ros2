# --- ROS Domain ID --
# Optional: Change if you are using a different ROS Domain ID
ROS_DOMAIN_ID=1

# -- Docker Images --
# Image Fallback (Uncomment to use local images instead of GHCR)
BACKEND_IMAGE=r2_jazzy_rail_alignment_robot:latest
GUI_IMAGE=r2_jazzy_rail_alignment_robot_gui:latest

# Socat TCP Device
IMU_TCP_DEVICE = "socat PTY,link=/dev/ttyUSBIMU,raw,echo=0 TCP:host.docker.internal:7780"
# Autostart script in gui container (true/false)
AUTOSTART=false